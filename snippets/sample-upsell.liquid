{% comment %}
  "Still unsure?" sample upsell — adds the picked product's selected/first available variant via product-form.
  Accepts:
    - block: the sample_upsell block
{% endcomment %}
{%- liquid
  assign sample_product = block.settings.product
  assign sample_variant = sample_product.selected_or_first_available_variant
  assign sample_form_id = 'sample-upsell-form-' | append: block.id
-%}
{%- if sample_product != blank and sample_variant != blank -%}
  <div class="flex gap-6 items-center my-6" {{ block.shopify_attributes }}>
    {%- if sample_product.featured_image -%}
      <img
        src="{{ sample_product.featured_image | image_url: width: 320 }}"
        alt="{{ sample_product.featured_image.alt | default: sample_product.title | escape }}"
        width="154"
        height="{{ 154 | divided_by: sample_product.featured_image.aspect_ratio | round }}"
        loading="lazy"
        class="w-[154px] h-auto shrink-0 rounded-lg object-cover bg-gray-50">
    {%- endif -%}

    <div class="grow min-w-0">
      {%- if block.settings.heading != blank -%}
        <h3 class="my-0 text-xl font-semibold tracking-normal text-black">{{ block.settings.heading }}</h3>
      {%- endif -%}
      {%- if block.settings.subheading != blank -%}
        <p class="mt-1 mb-0 text-base tracking-normal text-gray-600 leading-snug">{{ block.settings.subheading }}</p>
      {%- endif -%}

      <div class="flex items-center flex-wrap gap-3 mt-4">
        <span class="text-xl text-black">{{ sample_variant.price | money }}</span>
        {%- if block.settings.badge_text != blank -%}
          <span class="bg-[#1d1d1b] text-white text-sm font-medium uppercase px-4 py-1.5 rounded-full leading-none">{{ block.settings.badge_text }}</span>
        {%- endif -%}
      </div>

      <product-form class="product-form block mt-4 !mb-0">
        <div class="product-form__error-message-wrapper" role="alert" hidden>
          <span class="product-form__error-message"></span>
        </div>
        {%- form 'product', sample_product, id: sample_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" value="{{ sample_variant.id }}">
          <button
            type="submit"
            name="add"
            class="w-full max-w-[300px] rounded-lg border-2 border-solid border-black bg-white text-black text-lg font-medium py-3 px-4 cursor-pointer transition-colors hover:bg-black hover:text-white disabled:opacity-50 disabled:cursor-not-allowed relative"
            {% unless sample_variant.available %}disabled{% endunless %}>
            <span>
              {%- if sample_variant.available -%}
                {{ block.settings.button_label | default: 'Buy Sample' }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </span>
            {%- render 'loading-spinner' -%}
          </button>
        {%- endform -%}
      </product-form>
    </div>
  </div>
{%- endif -%}
